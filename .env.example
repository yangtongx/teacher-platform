# 复制为 .env 后填写。不要提交 .env。
DATA_DIR=./data
CORPUS_ROOT=/data/corpus
BIND_HOST=127.0.0.1
BIND_PORT=18900

# 第一次启动、库里还没有用户时，用这些值创建管理员。之后改密码不靠改这里。
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=老师

# 不填也能登录和切换身份；发消息时会提示未配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 浏览器只通过 HTTPS 访问时改为 1，会话 Cookie 才会带 Secure。
COOKIE_SECURE=0
